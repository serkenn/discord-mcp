# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Optional: comma-separated guild IDs the MCP server may touch (empty = all guilds the bot is in)
DISCORD_ALLOWED_GUILD_IDS=

# Optional: "true" registers read-only tools only
DISCORD_READ_ONLY=false

# Optional: "true" enables the discord_api_request escape hatch (arbitrary REST calls)
DISCORD_ALLOW_RAW_REQUESTS=false
